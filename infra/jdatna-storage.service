[Unit]
Description=Private Jdatna S3-compatible storage
Requires=docker.service srv-jdatna-data.mount
After=docker.service srv-jdatna-data.mount
BindsTo=srv-jdatna-data.mount

[Service]
Type=simple
WorkingDirectory=/opt/jdatna
ExecStartPre=/usr/bin/mountpoint -q /srv/jdatna/data
ExecStart=/usr/bin/docker compose -f /opt/jdatna/infra/storage.compose.yaml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f /opt/jdatna/infra/storage.compose.yaml stop -t 30
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
