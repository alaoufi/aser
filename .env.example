# Dedicated jdatna runtime PostgreSQL role; migrate separately with owner credentials.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Registration remains closed until providers pass real verification and this gate is explicit.
SMS_VERIFIED=false
PRIVATE_STORAGE_VERIFIED=false
SMS_WEBHOOK_URL=
SMS_ALLOWED_HOSTS=
SMS_WEBHOOK_TOKEN=
OTP_HASH_SECRET=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# 32 random bytes in hex; keep stable and back up securely outside Git.
DOCUMENT_ENCRYPTION_KEY=

# taqnyat uses the exact official endpoint and an approved existing sender.
SMS_PROVIDER=webhook
SMS_SENDER=
