{
  "name": "jdatna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "npx --yes @biomejs/biome@2.2.4 lint",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,cjs}\"",
    "test:filters": "playwright test tests/e2e/filters.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1177.0",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "leaflet": "^1.9.4",
    "mmdb-lib": "3.0.5",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "sortablejs": "1.15.7",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/leaflet": "^1.9.23",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/sortablejs": "1.15.9",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
